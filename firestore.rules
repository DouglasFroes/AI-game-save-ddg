rules_version = '2';

// Ranking: leaderboards/{gameId}/entries/{entryId} — one document per run, so the same player
// can hold several places (the game shows only the top 20). Campaign games (a running total of
// all levels) keep one document per player instead, named after their uid, which they update.
// - anyone can read the rankings
// - only players signed in with Google can add entries, and only in their own name (`player` = uid)
// - an anonymous player joining an existing Google account hands its runs over: it may change
//   `player` (and nothing else) on its own entries, to an account that has linked it
//   (accounts/{googleUid}/links/{anonymousUid}, written by that Google account)
// - fields and value ranges are validated to limit abuse
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboards/{gameId}/entries/{entryId} {
      allow read: if gameId in gameIds();

      allow create: if request.auth != null
        && isGoogle()
        && request.resource.data.player == request.auth.uid
        && gameId in gameIds()
        && validEntry(request.resource.data);

      allow update: if request.auth != null
        && ((isGoogle()
            && entryId == request.auth.uid
            && request.resource.data.player == request.auth.uid
            && gameId in campaignIds()
            && validEntry(request.resource.data))
          || (resource.data.player == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['player'])
            && request.resource.data.player is string
            && exists(/databases/$(database)/documents/accounts/$(request.resource.data.player)/links/$(request.auth.uid))));

      // A campaign total moved over from another device is merged into the player's own
      // document, and the old one removed.
      allow delete: if request.auth != null
        && isGoogle()
        && gameId in campaignIds()
        && resource.data.player == request.auth.uid
        && entryId != request.auth.uid;
    }

    match /accounts/{uid}/links/{other} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && isGoogle()
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time;
      allow delete: if false;
    }

    // ── Chat: only players signed in with Google can read or write anything ──────
    // chat_rooms/{room}/messages/{id}: room is 'geral' or a game id. A message is created in a
    // batch with chat_users/{uid}.last = now, which may only move forward 2 s after the previous
    // one: the server itself refuses floods. Authors may blank their own message; anyone may
    // set or clear their own reaction (one of a fixed set). Nothing is ever deleted.
    match /chat_rooms/{room}/messages/{msgId} {
      allow read: if isGoogle() && validRoom(room);

      allow create: if isGoogle()
        && validRoom(room)
        && validMessage(request.resource.data)
        && getAfter(/databases/$(database)/documents/chat_users/$(request.auth.uid)).data.last == request.time;

      allow update: if isGoogle() && validRoom(room)
        && ((resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'del'])
            && request.resource.data.text == ''
            && request.resource.data.del == true)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['r'])
            && validReaction()));

      allow delete: if false;
    }

    match /chat_users/{uid} {
      allow read: if isGoogle() && request.auth.uid == uid;
      allow create: if isGoogle() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last == request.time;
      allow update: if isGoogle() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last == request.time
        && resource.data.last < request.time - duration.value(2, 's');
      allow delete: if false;
    }

    // Who is online: one heartbeat document per player, written only by its owner.
    match /presence/{uid} {
      allow read: if isGoogle();
      allow create, update: if isGoogle() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'g', 'typing', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 16
        && request.resource.data.g is string && request.resource.data.g.size() <= 24
        && request.resource.data.typing is string && request.resource.data.typing.size() <= 24
        && request.resource.data.at == request.time;
      allow delete: if false;
    }

    // Reports for moderation: written by players, read only from the Firebase console.
    match /chat_reports/{reportId} {
      allow create: if isGoogle()
        && request.resource.data.keys().hasOnly(['by', 'room', 'msg', 'uid', 'at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.room is string && request.resource.data.room.size() <= 24
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 40
        && request.resource.data.uid is string && request.resource.data.uid.size() <= 128
        && request.resource.data.at == request.time;
      allow read, update, delete: if false;
    }

    match /telemetry_sessions/{sessionId} {
      allow read: if true;

      allow create, update: if request.auth != null
        && request.resource.data.player == request.auth.uid
        && validSession(request.resource.data);

      allow delete: if false;
    }

    function gameIds() {
      return ['doguinho', 'blockblast', 'sudoku', 'roadfighter',
              'game2048', 'flappybee', 'snake', 'stack', 'fruitmerge', 'grau', 'luta', 'bomba', 'turma', 'corre', 'crush',
              'lenha', 'piano', 'alvo', 'pula', 'atravessa', 'hexa',
              'tijolos', 'memoria', 'cores', 'milhao', 'memofases', 'bolha',
              'paciencia', 'ultima', 'territorio',
              'helix', 'zigue', 'ponte', 'corcerta', 'conta', 'cesto',
              'sequencia', 'relampago', 'trio', 'inverte', 'balao', 'toupeira',
              'corta', 'gelo', 'velha', 'ligue4', 'minas', 'bolhas',
              'blocos', 'comecome', 'nave', 'liquidos', 'ricochete', 'horda',
              'gancho', 'orbita', 'cadeia', 'escorrega', 'plinko', 'tinta',
              'espelhos', 'masmorra', 'pinball', 'dados', 'selecao', 'timesbr', 'brasileirao', 'sudoku2', 'milhao2',
              'penalti', 'golfe', 'tenis', 'basquete', 'boliche', 'curling', 'skate', 'boxe', 'ciclismo', 'esqui',
              'arqueiro', 'galeria', 'sniper'];
    }

    function isGoogle() {
      return request.auth != null && 'google.com' in request.auth.token.firebase.identities;
    }

    function validRoom(room) {
      return room == 'geral' || room in gameIds();
    }

    function validMessage(d) {
      return d.keys().hasOnly(['uid', 'name', 'text', 'at', 're'])
        && d.keys().hasAll(['uid', 'name', 'text', 'at'])
        && d.uid == request.auth.uid
        && d.name is string && d.name.size() > 0 && d.name.size() <= 16
        && d.text is string && d.text.size() > 0 && d.text.size() <= 280
        && !d.text.matches('(?s).*(https?://|www[.]).*')
        && d.at == request.time
        && (!('re' in d) || (d.re is map
          && d.re.keys().hasOnly(['id', 'name', 'text'])
          && d.re.id is string && d.re.id.size() <= 40
          && d.re.name is string && d.re.name.size() <= 16
          && d.re.text is string && d.re.text.size() <= 80));
    }

    // A player only touches their own key in the reaction map, with an allowed emoji.
    function validReaction() {
      let before = resource.data.get('r', {});
      let after = request.resource.data.get('r', {});
      return after is map && after.size() <= 500
        && after.diff(before).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in after)
          || after[request.auth.uid] in ['❤️', '🔥', '😂', '👏', '😮', '🏆']);
    }

    function campaignIds() {
      return ['doguinho', 'memofases'];
    }

    function validEntry(d) {
      return d.keys().hasOnly(['player', 'name', 'score', 'details', 'date'])
        && d.keys().hasAll(['player', 'name', 'score', 'details', 'date'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 16
        && d.score is int && d.score >= 0 && d.score <= 100000000
        && d.details is map && d.details.size() <= 6
        && d.date == request.time;
    }

    function validSession(d) {
      return d.keys().hasOnly(['player', 'name', 'gameId', 'durationSec', 'score', 'startedAt', 'date'])
        && d.keys().hasAll(['player', 'name', 'gameId', 'durationSec', 'score', 'startedAt', 'date'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 16
        && d.gameId in gameIds()
        && d.durationSec is int && d.durationSec >= 1 && d.durationSec <= 43200
        && d.score is int && d.score >= 0 && d.score <= 100000000
        && d.startedAt is string && d.startedAt.size() <= 40
        && d.date == request.time;
    }
  }
}
