rules_version = '2';

// Ranking: leaderboards/{gameId}/entries/{uid}
// - anyone can read the rankings
// - a signed-in (anonymous) player can only write their own document
// - fields and value ranges are validated to limit abuse
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboards/{gameId}/entries/{uid} {
      allow read: if gameId in gameIds();

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && gameId in gameIds()
        && validEntry(request.resource.data);

      allow delete: if false;
    }

    function gameIds() {
      return ['doguinho', 'blockblast', 'sudoku', 'roadfighter',
              'game2048', 'flappybee', 'snake', 'stack', 'fruitmerge', 'grau', 'luta', 'bomba', 'turma', 'corre', 'crush',
              'lenha', 'piano', 'alvo', 'pula', 'atravessa', 'fusao'];
    }

    function validEntry(d) {
      return d.keys().hasOnly(['name', 'score', 'details', 'date'])
        && d.keys().hasAll(['name', 'score', 'details', 'date'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 16
        && d.score is int && d.score >= 0 && d.score <= 100000000
        && d.details is map && d.details.size() <= 6
        && d.date == request.time;
    }
  }
}
