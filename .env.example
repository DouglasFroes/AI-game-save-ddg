# Copy to .env.local (or set in your hosting/CI) to enable the GLOBAL ranking via Firebase.
# Values come from Firebase console → Project settings → Your apps → Web app (firebaseConfig).
# They are public by design: security lives in firestore.rules.
# Leave empty to keep the ranking only on the device.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Optional password for the Admin Dashboard (/ch). Leave empty for direct access.
VITE_ADMIN_PASSWORD=
