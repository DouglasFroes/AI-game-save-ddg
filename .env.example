# Environment of the production deployment (Dokploy -> Environment tab) or of `docker compose up`.
# For local development see web/.env.example, admin/.env.example and api/.env.example.

# Connection URL of your PostgreSQL (the database must already exist; tables are created on startup).
# Add ?sslmode=require when the server requires TLS.
#   postgres://user:password@host:5432/fliper?sslmode=require
DATABASE_URL=

# Signs the players' session tokens: at least 32 random characters. Changing it signs everyone out.
#   openssl rand -hex 32
JWT_SECRET=

# OAuth client id of the Google sign-in (Google Cloud console -> APIs & Services -> Credentials ->
# OAuth client ID, "Web application"; add the site's address to "Authorized JavaScript origins").
GOOGLE_CLIENT_ID=

# Google accounts allowed into /admin, separated by commas.
ADMIN_EMAILS=
