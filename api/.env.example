# Local development: export these before `cargo run` (e.g. `set -a; source .env; set +a`).
DATABASE_URL=postgres://fliper:fliper@localhost:5432/fliper
JWT_SECRET=change-me-to-at-least-32-random-characters
GOOGLE_CLIENT_ID=
ADMIN_EMAILS=you@gmail.com
# Where the built game and admin panel are (not needed with `npm run dev` in web/ and admin/).
WEB_DIR=../web/dist
ADMIN_DIR=../admin/dist
BIND=127.0.0.1:8080
RUST_LOG=info,sqlx=warn
