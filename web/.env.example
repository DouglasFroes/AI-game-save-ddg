# Copy to .env.local (or set in your hosting/CI) to enable the GLOBAL ranking and the chat.
# OAuth client id of the Google sign-in (Google Cloud console -> APIs & Services -> Credentials ->
# OAuth client ID, type "Web application"; add the site's origin to "Authorized JavaScript origins").
# It is public by design. Leave empty to keep the ranking only on the device.
VITE_GOOGLE_CLIENT_ID=

# Only when the API runs on another host than the game (otherwise the same origin is used, and
# `npm run dev` proxies /api to http://localhost:8080).
VITE_API_URL=
